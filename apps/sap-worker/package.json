{
  "name": "@hotel/sap-worker",
  "version": "0.1.0",
  "private": true,
  "description": "HQ integration worker: pulls queued postings from the cloud API (outbound only) and posts them to SAP B1 via Service Layer",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@hotel/sap-sl-mock": "0.1.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
