{
  "name": "@hotel/sap-sl-mock",
  "version": "0.1.0",
  "private": true,
  "description": "In-memory SAP Business One Service Layer (b1s/v2) mock with fault injection, for dev/test until the client's SAP test company exists",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
