# Copy to deploy/env/test.env and replace every "change-me" (openssl rand -hex 32).
STACK=hotel-test
IMAGE_TAG=test
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
JWT_SECRET=change-me-at-least-32-characters-long
WORKER_TOKEN=change-me-at-least-32-characters-long
ENABLE_DEV_ENDPOINTS=true
SEED_PASSWORD=change-me-dev-password
# Booking confirmation emails. Leave SMTP_URL empty to queue emails without sending.
# e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM="YeaStay Reservations <reservations@example.com>"
